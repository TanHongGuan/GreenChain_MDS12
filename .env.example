# Local development values only. Replace secrets in deployed environments.
ENVIRONMENT=development
JWT_SECRET=change-me-in-real-environments-local-only
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Temporary development users until Member 3 connects PostgreSQL.
ENABLE_DEV_USERS=true
DEV_USER_PASSWORD=password
