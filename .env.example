# Local development values only. Replace secrets in deployed environments.
ENVIRONMENT=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
JWT_SECRET=change-me-in-real-environments-local-only
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL persistence
POSTGRES_DB=greenchain
POSTGRES_USER=greenchain
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://greenchain:change-this-local-password@localhost:${POSTGRES_PORT}/greenchain

# Demo-only passwordless login: login page lists accounts in a dropdown. Refused in production.
ACCOUNT_SELECT_LOGIN=false

# Development-only seed data. Required by the seed script.
DEV_SEED_PASSWORD=change-this-local-password

# Evidence storage: "local" (development, no tamper resistance) or "s3" (versioned + Object Lock)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./var/storage
MAX_UPLOAD_SIZE_MB=25

# S3 Object Lock evidence storage, used only when STORAGE_BACKEND=s3.
# See docs/STORAGE_S3_OBJECT_LOCK.md. Never put AWS access keys in this file:
# use `aws configure --profile <name>` / AWS SSO and name that profile here.
AWS_PROFILE=
S3_BUCKET=
AWS_REGION=ap-southeast-1
# Optional, for an S3-compatible local emulator only.
S3_ENDPOINT_URL=
S3_KEY_PREFIX=
# GOVERNANCE (removable by an admin with bypass permission) is the safe default for test buckets.
# COMPLIANCE cannot be shortened by anyone and additionally requires S3_ALLOW_COMPLIANCE_MODE=true.
S3_OBJECT_LOCK_MODE=GOVERNANCE
S3_RETENTION_DAYS=1
S3_LOCK_PROCESSED=true
S3_ALLOW_COMPLIANCE_MODE=false
