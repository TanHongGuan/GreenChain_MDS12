# Python virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment / secrets
.env
.env.*
!.env.example

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local logs
*.log

# Local database files, if any
*.db
*.sqlite
*.sqlite3

# Runtime storage
var/storage/*
!var/storage/.gitkeep

# Frontend dependencies/build output
node_modules/
dist/
deploy/.demo-dist/
.vite/
coverage/
.env.local
.env.*.local

# Dataset workbooks are not pushed; the generators and the expected-totals CSVs
# are. Rebuild them with the scripts in test_datasets/. The seed is fixed, so
# every cell comes back the same - the file bytes differ only because openpyxl
# stamps a fresh creation time into docProps/core.xml.
#
# test_datasets/workbooks/ is the exception: it is the supplied dataset pack and
# has no generator. Recover it from git history if a fresh clone needs it.
test_datasets/**/*.xlsx
test_datasets/*.zip
