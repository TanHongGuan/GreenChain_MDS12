# Copy to deploy/.env.demo (Git-ignored) and fill in. Used only by docker compose
# --env-file for the shared demo stack; it does not affect local `uvicorn`/`pytest` runs.
# See docs/SHARED_DEMO_BACKEND.md.

POSTGRES_DB=greenchain
POSTGRES_USER=greenchain
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Password for the seeded viewer/uploader/auditor accounts. Share it with the team privately.
DEV_SEED_PASSWORD=

# The address teammates open, e.g. http://192.168.1.20:8080 (this machine's Wi-Fi IP).
FRONTEND_ORIGIN=

# Evidence storage (docker-compose.s3.yml)
S3_BUCKET=greenchain-evidence-test
AWS_REGION=ap-southeast-1
AWS_PROFILE=greenchain-dev
# Absolute path to this machine's ~/.aws directory, e.g. /Users/<you>/.aws
AWS_CONFIG_DIR=
# Give each fresh deployment its own prefix (e.g. demo-2026-10-21/) so its evidence is kept apart
# from earlier runs. Locked objects under an old prefix stay until their retention ends.
S3_KEY_PREFIX=demo-fresh/
S3_OBJECT_LOCK_MODE=GOVERNANCE
S3_RETENTION_DAYS=1

# AI column mapping for unrecognised spreadsheet layouts. Optional; never put it in a VITE_ variable.
GEMINI_API_KEY=

# Load the Monosh demonstration on startup: 2 buildings, 5 approved quarterly submissions.
# Synthetic data and simulated approvals. Idempotent; refused when ENVIRONMENT=production.
DEMO_SEED_DATA=true
